{
  "name": "olimpiadas-stlc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "cf:secrets:dev": "node scripts/sync-cloudflare-secrets.mjs dev",
    "cf:secrets:prod": "node scripts/sync-cloudflare-secrets.mjs prod",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply olimpiadas-db-dev --env dev --local",
    "db:migrate:dev": "wrangler d1 migrations apply olimpiadas-db-dev --env dev --remote",
    "db:seed:local": "wrangler d1 execute olimpiadas-db-dev --env dev --local --file=./drizzle/seed.sql",
    "db:seed:dev": "wrangler d1 execute olimpiadas-db-dev --env dev --remote --file=./drizzle/seed.sql",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-auth": "^1.2.5",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.15.1",
    "lucide-react": "^0.468.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@opennextjs/cloudflare": "^1.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/diff": "^7.0.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.15.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0",
    "vitest": "^2.1.6",
    "wrangler": "^4.165.0"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
