{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "olimpiadas-stlc",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "olimpiadas-db-prod",
      "database_id": "62d0469d-8c03-42a9-ac45-98b320f85b02",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "olimpiadas-media-prod"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "APP_ENV": "prod",
    "BETTER_AUTH_URL": "https://olimpiadas.sitelocuento.com",
    "EMAIL_FROM_ADDRESS": "olimpiadas@sitelocuento.com",
    "EMAIL_FROM_NAME": "Olimpíadas Literarias de SiTeLoCuento"
  },
  "env": {
    "dev": {
      "name": "olimpiadas-stlc-dev",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "olimpiadas-db-dev",
          "database_id": "b03d7071-ddc3-4111-96e1-12c18da7245a",
          "migrations_dir": "drizzle/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "olimpiadas-media-dev"
        }
      ],
      "triggers": {
        "crons": ["*/15 * * * *"]
      },
      "vars": {
        "APP_ENV": "dev",
        "BETTER_AUTH_URL": "https://dev-olimpiadas.sitelocuento.com",
        "EMAIL_FROM_ADDRESS": "maratonpincelero@gmail.com",
        "EMAIL_FROM_NAME": "Olimpíadas Literarias de SiTeLoCuento (Dev)"
      }
    }
  }
}
